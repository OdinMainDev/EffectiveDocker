# Тип приложения
# Возможные значения:
# - all - запустить все сразу
# - admin - только api администрирования
# - casino - только api казино
# - games - только api игр
# - affiliate - только api аффилейтов
# - eventhandler - только обработчик событий
# - cronworker - только обработчик периодических задач
APP_TYPE=all

# Порты, на которых слушает то или иное api. Используется в зависимости от APP_TYPE.
APP_PORT_ADMIN=10600
APP_PORT_CASINO=10601
APP_PORT_GAMES=8082
APP_PORT_CHAT=8083
APP_PORT_AFFILIATE=8084

# Порт, на котором находится служба метрики. Запускается при любом значении APP_TYPE.
APP_PORT_METRICS=8085

# Соль для шифрования сессий
APP_

# Признак запуска отладочной версии. В основном меняет логирование и некоторые нюансы поведения
APP_DEBUG=true

# Настройка соединения с базой данных PostreSQL, значения должны быть понятны по названию
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=esdatabasemain
DB_USER=effectivesolutiondatabaseuser
DB_PASSWORD=fH9hM0pA4m

# Настройка соединения с внешним кешем Redis
REDIS=true
REDIS_HOST=esredis:6379
REDIS_CLEAR_AT_STARTUP=true

# Настройка соединения с сервером очередей RabbitMQ
RABBITMQ_USERNAME=esuser
RABBITMQ_PASSWORD=espassword
RABBITMQ_HOST=esrabbitmq
RABBITMQ_PORT=5672

# Настройка параметров для проверки пользовательских загрузок на вирусы
CLAMAV_SKIP_VALIDATION=true
CLAMAV_URL=esclamav:3310

# Использовать ли тестовый сервер Мобуля
USE_TEST_GAME_APIS=true

# Адрес сборщика телеметриеской информации. Если пустой, то телеметрия не собирается.
TELEMETRY_COLLECTOR_HOST="otel-collector:4318"
