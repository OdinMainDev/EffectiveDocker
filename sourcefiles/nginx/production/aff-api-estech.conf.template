map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name aff-api${SERVER_TYPE}-v2.effective-solution.com;
    ssl_certificate /etc/letsencrypt/live/aff-api${SERVER_TYPE}-v2.effective-solution.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aff-api${SERVER_TYPE}-v2.effective-solution.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/aff-api${SERVER_TYPE}-v2.effective-solution.com/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;
    client_max_body_size 108M;
    root /web_admin;
    charset utf-8;
    access_log /application/storage/logs/aff-api-access.log;
    error_log  /application/storage/logs/aff-api-error.log;
    
    # add_header 'Access-Control-Allow-Origin' "$http_origin" always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
    add_header 'Access-Control-Allow-Headers' 'Accept,Authorization,Cache-Control,Content-Type,DNT,If-Modified-Since,Keep-Alive,Origin,User-Agent,X-Requested-With' always;
    add_header 'Access-Control-Expose-Headers' 'Authorization' always;

    location / {
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        proxy_set_header Scheme $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_hide_header X-Powered-By;
        add_header Content-Security-Policy "upgrade-insecure-requests";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-transform" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Robots-Tag none;
    
        proxy_pass http://esapp:${APP_PORT_AFFILIATE};
    }
}
