map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name metrics${SERVER_TYPE}-v2.effective-solution.com;
    ssl_certificate /etc/letsencrypt/live/metrics${SERVER_TYPE}-v2.effective-solution.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/metrics${SERVER_TYPE}-v2.effective-solution.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/metrics${SERVER_TYPE}-v2.effective-solution.com/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;
    client_max_body_size 108M;

    location / {
        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        resolver 127.0.0.11;
    }
}
