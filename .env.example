# Database Configuration
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password

# Redis Configuration
REDIS_HOST=esredis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# RabbitMQ Configuration
RABBITMQ_HOST=esrabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password
RABBITMQ_USERNAME=your_rabbitmq_user
RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# ClamAV Configuration
CLAMAV_HOST=esclamav
CLAMAV_PORT=3310

# Telemetry Configuration
TELEMETRY_COLLECTOR_HOST=otel-collector:4318

# Server Type (-stage or null)
SERVER_TYPE=-stage

# Domain version (-v2 or null)
DOMAIN_VERSION=-v2

# Docker Image Versions for Monitoring
LOKI_IMAGE_TAG=2.9.0
PROMTAIL_IMAGE_TAG=2.9.0
JAEGER_IMAGE_TAG=1.50.0

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
HEALTH_CHECK_FULL_NOTIFICATIONS=false

# Configuration Types
CONFIG_TYPE=local
CONFIG_TYPE2=generate
CONFIG_TYPE3=production